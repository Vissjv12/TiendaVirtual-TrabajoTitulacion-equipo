# Copiar a /etc/tienda-backup/backup.env (root:tienda-backup, permisos 640).
# NO contiene credenciales: estas van en my.cnf y restore.cnf (permisos 600).

BACKUP_DIR=/var/backups/tienda
DATABASES="auth_service productos inventario ventas"
RETENTION_DAYS=14
MIN_KEEP=3
MYSQL_DEFAULTS_FILE=/etc/tienda-backup/my.cnf
RESTORE_DEFAULTS_FILE=/etc/tienda-backup/restore.cnf

# MySQL 8: dejar el valor por defecto (--set-gtid-purged=OFF).
# MariaDB: descomentar la linea siguiente (MariaDB no reconoce esa opcion).
# MYSQLDUMP_EXTRA_OPTS=
