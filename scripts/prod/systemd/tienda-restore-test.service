[Unit]
Description=Tienda Virtual - prueba de restauracion del ultimo respaldo en bases temporales (T01)
Documentation=file:///opt/tienda/scripts/prod/INSTALACION-RESPALDOS.md
After=mysqld.service tienda-backup.service

[Service]
Type=oneshot
User=tienda-backup
Group=tienda-backup
EnvironmentFile=/etc/tienda-backup/backup.env
ExecStart=/opt/tienda/scripts/prod/restore-test-db.sh
Nice=10
TimeoutStartSec=2h

# Solo lee los respaldos; las bases temporales viven en MySQL
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/var/backups/tienda
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077
