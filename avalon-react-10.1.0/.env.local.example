# API Gateway Unificado (Actividad A-13)
# Punto único de entrada hacia todos los microservicios (productos, inventario, ventas y autenticación).
# Debe coincidir con GATEWAY_PORT del .env de la raíz (Docker Compose del gateway).
# Next.js solo lee esta variable desde ESTA carpeta; ponerla en el .env de la raíz no tiene efecto.
# Windows local:
#   - Si VMware ocupa el 8080, usar el puerto 8090 (y GATEWAY_PORT=8090 en el .env de la raíz).
#   - Usar 127.0.0.1 en lugar de localhost: un relay IPv6 de Windows (dllhost) puede capturar
#     ::1 en los puertos de Docker y dejar las solicitudes colgadas hasta el timeout.
#   Ejemplo: NEXT_PUBLIC_GATEWAY_URL=http://127.0.0.1:8090
# Tras cambiarla, reiniciar `npm run dev`: las variables NEXT_PUBLIC_* se leen solo al arrancar.
NEXT_PUBLIC_GATEWAY_URL=http://127.0.0.1:8080

# Stripe Keys (Test Mode)
# Obtén tus claves en: https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY_HERE
