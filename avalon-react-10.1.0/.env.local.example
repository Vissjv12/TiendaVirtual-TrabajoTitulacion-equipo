# API Gateway Unificado (Actividad A-13)
# Punto único de entrada hacia todos los microservicios (productos, inventario, ventas y autenticación).
# Si en Windows local el puerto 8080 está ocupado por VMware, usar http://localhost:8090
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080

# Stripe Keys (Test Mode)
# Obtén tus claves en: https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY_HERE
