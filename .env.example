# Variables de entorno para producción
# Copiar este archivo a .env y configurar valores reales

# Stripe Payment Gateway
STRIPE_API_KEY=REEMPLAZAR_CON_LA_CLAVE_SECRETA_DEL_ENTORNO
STRIPE_WEBHOOK_SECRET=REEMPLAZAR_CON_EL_SECRETO_DEL_WEBHOOK_DEL_ENTORNO

# MySQL (opcional, usar si cambias las credenciales)
MYSQL_ROOT_PASSWORD=REEMPLAZAR_CON_LA_CLAVE_ROOT_DEL_ENTORNO
MYSQL_USER=admin
MYSQL_PASSWORD=REEMPLAZAR_CON_LA_CLAVE_DEL_USUARIO_DE_APLICACION

# Seguridad de la aplicaciÃ³n
JWT_SECRET=REEMPLAZAR_CON_UN_SECRETO_ALEATORIO_DE_256_BITS

# Credenciales aisladas para docker-compose.test.yml
TEST_MYSQL_ROOT_PASSWORD=REEMPLAZAR_CON_LA_CLAVE_ROOT_DE_PRUEBAS
TEST_MYSQL_DATABASE=productos
TEST_MYSQL_USER=admin
TEST_MYSQL_PASSWORD=REEMPLAZAR_CON_LA_CLAVE_DE_PRUEBAS
TEST_MYSQL_PORT=3307
TEST_REDIS_HOST=127.0.0.1
TEST_REDIS_PORT=6380
TEST_REDIS_USERNAME=
TEST_REDIS_PASSWORD=
TEST_JWT_SECRET=REEMPLAZAR_CON_UN_SECRETO_ALEATORIO_DE_256_BITS

# Pilot Redis de catálogo; desactivado por defecto
CACHE_REDIS_ENABLED=false
CACHE_REDIS_PRODUCTOS_LISTADO_ENABLED=false
CACHE_REDIS_CATEGORIAS_ENABLED=false
CACHE_REDIS_TTL_PRODUCTOS=PT5M
CACHE_REDIS_TTL_CATEGORIAS=PT15M
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_CONNECT_TIMEOUT=500ms
REDIS_TIMEOUT=500ms

# Usuario administrador de Camunda
CAMUNDA_BPM_ADMIN_USER_ID=admin
CAMUNDA_BPM_ADMIN_USER_PASSWORD=REEMPLAZAR_CON_LA_CLAVE_DE_CAMUNDA

# Correo para recuperaciÃ³n de contraseÃ±as
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=REEMPLAZAR_CON_EL_USUARIO_SMTP
MAIL_PASSWORD=REEMPLAZAR_CON_LA_CLAVE_SMTP
MAIL_FROM=noreply@ecommerce-sigchos.com
MAIL_FROM_NAME=Sigchos E-commerce

# Puerto de exposición del frontend
FRONTEND_PORT=3000

# Puertos de Gateway y microservicios (cambiar si hay conflictos, ej. GATEWAY_PORT=8090 si VMware ocupa el 8080)
# Si se cambia GATEWAY_PORT, actualizar también NEXT_PUBLIC_GATEWAY_URL en avalon-react-10.1.0/.env.local
# (el frontend no lee este archivo).
GATEWAY_PORT=8080
EUREKA_PORT=8761
PRODUCTO_PORT=8081
INVENTARIO_PORT=8082
VENTAS_PORT=8083
AUTH_PORT=8084

# Google OAuth (login con Google)
# Crear credenciales en https://console.cloud.google.com/apis/credentials
# El mismo Client ID va en el backend (GOOGLE_CLIENT_ID) y en el frontend (NEXT_PUBLIC_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com

# Correo del administrador (destino de los mensajes de Ubicación y Contacto)
NEXT_PUBLIC_ADMIN_EMAIL=admin@ecommerce-sigchos.com
